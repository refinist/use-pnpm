{
  "name": "use-pnpm",
  "version": "1.0.0",
  "description": "Automatically fetch the latest pnpm version and set packageManager field",
  "keywords": [
    "pnpm",
    "packageManager",
    "corepack"
  ],
  "homepage": "https://github.com/refinist/use-pnpm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/refinist/use-pnpm.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "bin": {
    "use-pnpm": "./bin/cli.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "release": "bumpp",
    "test": "node --test"
  },
  "prettier": "@refinist/prettier-config",
  "devDependencies": {
    "@refinist/eslint-config": "^1.0.4",
    "@refinist/prettier-config": "^0.0.4",
    "bumpp": "^10.3.2",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
